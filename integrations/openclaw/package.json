{
  "name": "@rocke-dong/oam-openclaw",
  "version": "0.0.2",
  "description": "Open Agent Memory plugin for OpenClaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocke2020/open-agent-memory.git",
    "directory": "integrations/openclaw"
  },
  "homepage": "https://github.com/rocke2020/open-agent-memory/tree/main/integrations/openclaw",
  "keywords": ["agent-memory", "openclaw", "memory", "self-hosted", "postgresql"],
  "type": "module",
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist/index.js",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "setup": "node setup.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "oam-openclaw-setup": "./setup.mjs"
  },
  "files": [
    "setup.mjs",
    "index.ts",
    "cron.ts",
    "dist/index.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.11.1"
    },
    "install": {
      "minHostVersion": ">=2026.9.6"
    }
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
