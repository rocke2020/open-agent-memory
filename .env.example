# Machine-local PostgreSQL connection strings. Use distinct database roles.
# OAM_CONFIG=/absolute/path/to/oam.yaml
OAM_MIGRATION_DSN=postgresql://oam_migration:replace-me@127.0.0.1:5432/oam
OAM_API_DSN=postgresql://oam_api:replace-me@127.0.0.1:5432/oam
OAM_WORKER_QUEUE_DSN=postgresql://oam_worker_queue:replace-me@127.0.0.1:5432/oam
OAM_WORKER_CONTENT_DSN=postgresql://oam_worker_content:replace-me@127.0.0.1:5432/oam

# Optional private Profile-development launcher database name on its local PostgreSQL instance.
# The product uses the explicit OAM_*_DSN variables above; this name is read only by a private local launcher.
OAM_OPENCLAW_DATABASE=oam_openclaw_profile_dev

# New operator-only file used once by the initial oam migrate bootstrap.
OAM_BOOTSTRAP_OUTPUT=/secure/operator/path/oam-bootstrap-key
# A separate new destination used only for explicit lost-handoff recovery.
OAM_BOOTSTRAP_RECOVERY_OUTPUT=/secure/operator/path/oam-bootstrap-replacement-key

# Model variables referenced by the canonical bindings.
OAM_GENERATIVE_MODEL=replace-me
OAM_GENERATIVE_ENDPOINT=https://replace-me.example/v1
OAM_GENERATIVE_API_KEY=replace-me
OAM_EMBEDDING_URL=https://replace-me.example/v1
OAM_EMBEDDING_KEY=replace-me
OAM_EMBEDDING_MODEL=replace-me

# Optional local VLM client settings. These names are not read by OAM itself;
# map them to the endpoint/key names selected by configs/oam.yaml when using a
# local VLM launcher or helper script.
VLM_BASE_URL=https://replace-me.example/v1
VLM_API_KEY=replace-me
VLM_MODEL=replace-me
VLM_URL_TYPE=openai_compatible
